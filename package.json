{
  "name": "achat",
  "version": "4.0.0-alpha.1",
  "private": true,
  "description": "Local-first, team-ready AI agent workspace",
  "license": "MIT",
  "author": "AprilNEA <github@sku.moe>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AprilNEA/AChat"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter @achat/web",
    "dev:desktop": "turbo run dev --filter @achat/desktop",
    "check-types": "turbo run check-types",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
